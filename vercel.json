{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/", "destination": "/frontend/login.html" },
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/login.html", "destination": "/frontend/login.html" },
    { "source": "/register", "destination": "/frontend/register.html" },
    { "source": "/register.html", "destination": "/frontend/register.html" },
    { "source": "/user-dashboard", "destination": "/frontend/user-dashboard.html" },
    { "source": "/user-dashboard.html", "destination": "/frontend/user-dashboard.html" },
    { "source": "/staff-dashboard", "destination": "/frontend/staff-dashboard.html" },
    { "source": "/staff-dashboard.html", "destination": "/frontend/staff-dashboard.html" },
    { "source": "/admin", "destination": "/frontend/index.html" },
    { "source": "/index", "destination": "/frontend/index.html" },
    { "source": "/index.html", "destination": "/frontend/index.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
